import React, { useState, useEffect, useRef } from 'react';
import {
  CalendarDays,
  ChevronLeft,
  ChevronRight,
  Image as ImageIcon,
  Upload,
  X,
  Check,
  Save,
  LogOut,
  Sparkles,
  BookOpen
} from 'lucide-react';

/* ---------------------------------------------------------
 * DATE & CALENDAR HELPER FUNCTIONS (LOCAL TIME ONLY)
 * --------------------------------------------------------- */

/**
 * Formats a given Date instance into YYYY-MM-DD using local time parts.
 * Avoids toISOString() to prevent UTC day shifts.
 */
function getLocalDateKey(date) {
  const year = date.getFullYear();
  const month = String(date.getMonth() + 1).padStart(2, '0');
  const day = String(date.getDate()).padStart(2, '0');
  return `${year}-${month}-${day}`;
}

/**
 * Returns a new Date set to the Monday of the week for the passed date (00:00:00 local).
 */
function getMondayOfWeek(date) {
  const d = new Date(date.getFullYear(), date.getMonth(), date.getDate());
  const day = d.getDay(); // 0 is Sunday, 1 is Monday, ..., 6 is Saturday
  // Distance to previous or current Monday
  const diff = day === 0 ? -6 : 1 - day;
  d.setDate(d.getDate() + diff);
  d.setHours(0, 0, 0, 0);
  return d;
}

/**
 * Generates an array of exactly 7 consecutive days starting from Monday.
 */
function generateWeekDays(mondayDate) {
  return Array.from({ length: 7 }, (_, i) => {
    const day = new Date(mondayDate);
    day.setDate(mondayDate.getDate() + i);
    return day;
  });
}

/**
 * Determines whether a date is 'PAST', 'TODAY', or 'FUTURE' relative to today's local date key.
 */
function getDayStatus(targetDate, todayKey) {
  const targetKey = getLocalDateKey(targetDate);
  if (targetKey === todayKey) return 'TODAY';
  return targetKey < todayKey ? 'PAST' : 'FUTURE';
}

/**
 * Formats the weekly date span into a gentle human-readable label.
 * E.g., "2 – 8 November 2026" or "28 October – 3 November 2026"
 */
function formatWeekRange(startDate, endDate) {
  const startDay = startDate.getDate();
  const endDay = endDate.getDate();
  const startMonth = startDate.toLocaleDateString(undefined, { month: 'short' });
  const endMonth = endDate.toLocaleDateString(undefined, { month: 'short' });
  const startYear = startDate.getFullYear();
  const endYear = endDate.getFullYear();

  if (startYear !== endYear) {
    return `${startDay} ${startMonth} ${startYear} – ${endDay} ${endMonth} ${endYear}`;
  }
  if (startMonth !== endMonth) {
    return `${startDay} ${startMonth} – ${endDay} ${endMonth} ${startYear}`;
  }
  return `${startDay} – ${endDay} ${startMonth} ${startYear}`;
}

/**
 * Generates minimal dynamic initial mock entries relative to the user's current day.
 */
function generateInitialMockEntries(today) {
  const entries = {};

  // 1 day ago
  const d1 = new Date(today);
  d1.setDate(today.getDate() - 1);
  const key1 = getLocalDateKey(d1);
  entries[key1] = {
    moodDate: key1,
    mood: 'Focused and productive throughout the quiet morning.',
    imageUrl: null,
  };

  // 3 days ago
  const d2 = new Date(today);
  d2.setDate(today.getDate() - 3);
  const key2 = getLocalDateKey(d2);
  entries[key2] = {
    moodDate: key2,
    mood: 'Relaxed after a busy week, spent time outside.',
    imageUrl: null,
  };

  // 5 days ago
  const d3 = new Date(today);
  d3.setDate(today.getDate() - 5);
  const key3 = getLocalDateKey(d3);
  entries[key3] = {
    moodDate: key3,
    mood: 'Learning something new and taking notes.',
    imageUrl: null,
  };

  return entries;
}

/* ---------------------------------------------------------
 * MAIN COMPONENT
 * --------------------------------------------------------- */

export default function MoodInputScreen({ user, onLogout }) {
  // Safe fallbacks for user profile
  const userName = user?.name?.trim() || 'Friend';
  const userEmail = user?.email?.trim() || '';

  // Today reference (Local)
  const [todayDate] = useState(() => new Date());
  const todayKey = getLocalDateKey(todayDate);

  // Active viewing week's Monday
  const [currentMonday, setCurrentMonday] = useState(() => getMondayOfWeek(new Date()));

  // Active selected day to inspect or edit (defaulting to today)
  const [selectedDate, setSelectedDate] = useState(() => new Date());
  const selectedKey = getLocalDateKey(selectedDate);
  const selectedStatus = getDayStatus(selectedDate, todayKey);

  // Stored mood entries dictionary: { [YYYY-MM-DD]: { moodDate, mood, imageUrl } }
  const [entries, setEntries] = useState(() => generateInitialMockEntries(todayDate));

  // Today's editor form state
  const [todayText, setTodayText] = useState(() => entries[todayKey]?.mood || '');
  const [imageFile, setImageFile] = useState(null);
  const [imagePreviewUrl, setImagePreviewUrl] = useState(() => entries[todayKey]?.imageUrl || null);
  const [fileError, setFileError] = useState('');
  const [saveSuccessMessage, setSaveSuccessMessage] = useState('');

  const fileInputRef = useRef(null);

  // Sync draft if an existing saved entry for today already exists in state
  useEffect(() => {
    if (entries[todayKey]) {
      setTodayText(entries[todayKey].mood || '');
      if (entries[todayKey].imageUrl && !imagePreviewUrl) {
        setImagePreviewUrl(entries[todayKey].imageUrl);
      }
    }
  }, [entries, todayKey]);

  // Clean up created object URLs to prevent browser memory leaks
  useEffect(() => {
    return () => {
      if (imagePreviewUrl && imagePreviewUrl.startsWith('blob:')) {
        URL.revokeObjectURL(imagePreviewUrl);
      }
    };
  }, [imagePreviewUrl]);

  // Calendar week calculations
  const weekDays = generateWeekDays(currentMonday);
  const weekEndDay = weekDays[6];
  const isCurrentWeekDisplayed = getLocalDateKey(currentMonday) === getLocalDateKey(getMondayOfWeek(todayDate));

  // Navigation handlers
  const handlePrevWeek = () => {
    setCurrentMonday((prev) => {
      const nextDate = new Date(prev);
      nextDate.setDate(prev.getDate() - 7);
      return nextDate;
    });
  };

  const handleNextWeek = () => {
    setCurrentMonday((prev) => {
      const nextDate = new Date(prev);
      nextDate.setDate(prev.getDate() + 7);
      return nextDate;
    });
  };

  const handleGoToToday = () => {
    const monday = getMondayOfWeek(todayDate);
    setCurrentMonday(monday);
    setSelectedDate(new Date(todayDate));
  };

  // Image upload handling & validation
  const handleImageChange = (e) => {
    const file = e.target.files?.[0];
    setFileError('');

    if (!file) return;

    const validTypes = ['image/jpeg', 'image/png', 'image/webp'];
    if (!validTypes.includes(file.type)) {
      setFileError('Please choose a JPEG, PNG, or WebP image.');
      if (fileInputRef.current) fileInputRef.current.value = '';
      return;
    }

    const maxBytes = 5 * 1024 * 1024; // 5 MB
    if (file.size > maxBytes) {
      setFileError('Image exceeds 5 MB. Please choose a smaller file.');
      if (fileInputRef.current) fileInputRef.current.value = '';
      return;
    }

    if (imagePreviewUrl && imagePreviewUrl.startsWith('blob:')) {
      URL.revokeObjectURL(imagePreviewUrl);
    }

    const preview = URL.createObjectURL(file);
    setImageFile(file);
    setImagePreviewUrl(preview);
  };

  const handleRemoveImage = () => {
    if (imagePreviewUrl && imagePreviewUrl.startsWith('blob:')) {
      URL.revokeObjectURL(imagePreviewUrl);
    }
    setImageFile(null);
    setImagePreviewUrl(null);
    setFileError('');
    if (fileInputRef.current) {
      fileInputRef.current.value = '';
    }
  };

  // Save mood handler
  const handleSaveTodayMood = (e) => {
    e.preventDefault();

    if (!todayText.trim()) return;

    setEntries((prev) => ({
      ...prev,
      [todayKey]: {
        moodDate: todayKey,
        mood: todayText.trim(),
        imageUrl: imagePreviewUrl,
      },
    }));

    setSaveSuccessMessage("Today's mood has been saved.");
    const timer = setTimeout(() => {
      setSaveSuccessMessage('');
    }, 4000);

    return () => clearTimeout(timer);
  };

  const activeEntryForSelected = entries[selectedKey];

  return (
    <div className="min-h-screen bg-slate-50 text-slate-900 flex flex-col">
      {/* ----------------- Top Header ----------------- */}
      <header className="border-b border-slate-200 bg-white">
        <div className="max-w-4xl mx-auto px-4 sm:px-6 py-4 flex items-center justify-between gap-4">
          <div className="flex items-center gap-3">
            <div className="w-10 h-10 rounded-2xl bg-indigo-50 text-indigo-600 flex items-center justify-center shrink-0 border border-indigo-100">
              <BookOpen className="w-5 h-5" />
            </div>
            <div>
              <div className="flex items-center gap-1.5">
                <span className="font-semibold text-slate-900 tracking-tight text-base sm:text-lg">
                  Mood Yourself
                </span>
                <span className="inline-flex items-center text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded-full bg-violet-100 text-violet-700">
                  Journal
                </span>
              </div>
              <p className="text-xs text-slate-500">
                {userEmail ? userEmail : 'Private daily reflections'}
              </p>
            </div>
          </div>

          <div className="flex items-center gap-3">
            <button
              type="button"
              onClick={onLogout}
              className="inline-flex items-center gap-1.5 text-xs sm:text-sm font-medium text-slate-600 hover:text-slate-900 px-3 py-2 rounded-xl hover:bg-slate-100 transition-colors focus:outline-none focus:ring-2 focus:ring-indigo-500"
              aria-label="Sign out of your account"
            >
              <LogOut className="w-4 h-4" />
              <span>Sign Out</span>
            </button>
          </div>
        </div>
      </header>

      {/* ----------------- Main Journal Canvas ----------------- */}
      <main className="flex-1 max-w-4xl w-full mx-auto px-4 sm:px-6 py-6 sm:py-8 space-y-6">
        {/* Welcome Banner */}
        <section className="space-y-1">
          <h1 className="text-xl sm:text-2xl font-semibold text-slate-900 tracking-tight">
            Hello, {userName}
          </h1>
          <p className="text-sm text-slate-500">
            How are you feeling today? Take one quiet minute to write it down.
          </p>
        </section>

        {/* ----------------- Week Navigation Strip ----------------- */}
        <section
          aria-label="Week navigation"
          className="bg-white border border-slate-200 rounded-3xl p-4 sm:p-5 shadow-sm space-y-4"
        >
          <div className="flex flex-wrap items-center justify-between gap-3">
            <div className="flex items-center gap-2">
              <CalendarDays className="w-4 h-4 text-indigo-600" />
              <h2 className="text-sm sm:text-base font-medium text-slate-800">
                {formatWeekRange(weekDays[0], weekEndDay)}
              </h2>
            </div>

            <div className="flex items-center gap-1.5 ml-auto">
              <button
                type="button"
                onClick={handlePrevWeek}
                className="p-2 text-slate-600 hover:text-slate-900 hover:bg-slate-100 rounded-xl transition-colors focus:outline-none focus:ring-2 focus:ring-indigo-500"
                aria-label="Previous week"
              >
                <ChevronLeft className="w-4 h-4" />
              </button>

              <button
                type="button"
                onClick={handleGoToToday}
                disabled={isCurrentWeekDisplayed && selectedKey === todayKey}
                className={`px-3 py-1.5 text-xs font-medium rounded-xl transition-colors focus:outline-none focus:ring-2 focus:ring-indigo-500 ${
                  isCurrentWeekDisplayed && selectedKey === todayKey
                    ? 'text-slate-400 bg-slate-50 cursor-not-allowed'
                    : 'text-indigo-600 bg-indigo-50 hover:bg-indigo-100'
                }`}
              >
                Today
              </button>

              <button
                type="button"
                onClick={handleNextWeek}
                className="p-2 text-slate-600 hover:text-slate-900 hover:bg-slate-100 rounded-xl transition-colors focus:outline-none focus:ring-2 focus:ring-indigo-500"
                aria-label="Next week"
              >
                <ChevronRight className="w-4 h-4" />
              </button>
            </div>
          </div>

          {/* 7-Day Overview Grid */}
          <div className="grid grid-cols-7 gap-1.5 sm:gap-2">
            {weekDays.map((date) => {
              const dateKey = getLocalDateKey(date);
              const status = getDayStatus(date, todayKey);
              const isSelected = dateKey === selectedKey;
              const hasEntry = Boolean(entries[dateKey]?.mood);
              const weekdayName = date.toLocaleDateString(undefined, { weekday: 'narrow' });
              const dayNumber = date.getDate();

              let containerClasses =
                'flex flex-col items-center justify-between p-2 sm:p-2.5 rounded-2xl transition-all border text-center ';

              if (isSelected) {
                containerClasses += 'border-indigo-500 bg-indigo-50/50 ring-2 ring-indigo-500/20 ';
              } else if (status === 'TODAY') {
                containerClasses += 'border-indigo-300 bg-indigo-50/30 hover:border-indigo-400 ';
              } else if (status === 'PAST') {
                containerClasses += 'border-slate-200 bg-white hover:border-slate-300 ';
              } else {
                containerClasses += 'border-slate-100 bg-slate-50/70 text-slate-400 ';
              }

              return (
                <button
                  key={dateKey}
                  type="button"
                  onClick={() => setSelectedDate(date)}
                  className={containerClasses}
                  aria-label={`${date.toLocaleDateString(undefined, {
                    weekday: 'short',
                    month: 'short',
                    day: 'numeric',
                  })}, ${status.toLowerCase()}${hasEntry ? ', reflection saved' : ''}`}
                >
                  <span className="text-[11px] font-medium text-slate-500">
                    {weekdayName}
                  </span>
                  <span
                    className={`text-sm sm:text-base font-semibold my-0.5 ${
                      status === 'TODAY'
                        ? 'text-indigo-600 font-bold'
                        : isSelected
                        ? 'text-slate-900'
                        : 'text-slate-700'
                    }`}
                  >
                    {dayNumber}
                  </span>

                  {/* Indicator dot */}
                  <span className="h-1.5 w-1.5 rounded-full flex items-center justify-center">
                    {hasEntry ? (
                      <span className="h-1.5 w-1.5 rounded-full bg-indigo-500" />
                    ) : status === 'TODAY' ? (
                      <span className="h-1 w-1 rounded-full bg-indigo-300" />
                    ) : (
                      <span className="h-1.5 w-1.5" />
                    )}
                  </span>
                </button>
              );
            })}
          </div>
        </section>

        {/* ----------------- Selected Date Detail / Today Editor ----------------- */}
        <section aria-label="Day detail view">
          {selectedStatus === 'TODAY' ? (
            /* ================= TODAY: FOCUS EDITOR ================= */
            <div className="bg-white border-2 border-indigo-200/80 rounded-3xl p-5 sm:p-7 shadow-sm space-y-6">
              {/* Card Header */}
              <div className="flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 pb-4">
                <div className="space-y-0.5">
                  <div className="flex items-center gap-2">
                    <span className="px-2 py-0.5 text-xs font-semibold rounded-full bg-indigo-100 text-indigo-700 uppercase tracking-wide">
                      Today
                    </span>
                    <span className="text-sm text-slate-600 font-medium">
                      {selectedDate.toLocaleDateString(undefined, {
                        weekday: 'long',
                        month: 'short',
                        day: 'numeric',
                      })}
                    </span>
                  </div>
                  <h2 className="text-lg sm:text-xl font-bold text-slate-900">
                    How are you feeling?
                  </h2>
                </div>
                <div className="flex items-center gap-1.5 text-xs text-indigo-600 bg-indigo-50 px-2.5 py-1 rounded-xl">
                  <Sparkles className="w-3.5 h-3.5" />
                  <span>One small check-in is enough.</span>
                </div>
              </div>

              {/* Editor Form */}
              <form onSubmit={handleSaveTodayMood} className="space-y-5">
                {/* Textarea */}
                <div className="space-y-1.5">
                  <label
                    htmlFor="today-mood-input"
                    className="block text-xs font-semibold uppercase tracking-wider text-slate-500"
                  >
                    Your reflection
                  </label>
                  <textarea
                    id="today-mood-input"
                    rows={4}
                    maxLength={200}
                    value={todayText}
                    onChange={(e) => setTodayText(e.target.value)}
                    placeholder="Take a moment and put today into words..."
                    className="w-full rounded-2xl border border-slate-200 p-3.5 text-slate-900 placeholder:text-slate-400 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 text-sm leading-relaxed transition-all resize-none"
                  />
                  <div className="flex justify-end">
                    <span
                      className={`text-xs ${
                        todayText.length >= 200 ? 'text-amber-600 font-medium' : 'text-slate-400'
                      }`}
                      aria-live="polite"
                    >
                      {todayText.length} / 200
                    </span>
                  </div>
                </div>

                {/* Image Section */}
                <div className="space-y-2">
                  <label className="block text-xs font-semibold uppercase tracking-wider text-slate-500">
                    Add an image to today&apos;s mood
                  </label>

                  {imagePreviewUrl ? (
                    <div className="relative rounded-2xl border border-slate-200 overflow-hidden bg-slate-50 p-3 flex flex-col sm:flex-row items-center gap-4">
                      <div className="h-32 w-32 rounded-xl overflow-hidden bg-slate-200 shrink-0 border border-slate-200/80">
                        <img
                          src={imagePreviewUrl}
                          alt="Today's mood visual preview"
                          className="h-full w-full object-cover"
                        />
                      </div>
                      <div className="flex-1 min-w-0 space-y-2 text-center sm:text-left">
                        <p className="text-xs font-medium text-slate-700 truncate">
                          {imageFile ? imageFile.name : 'Saved mood photo'}
                        </p>
                        <p className="text-[11px] text-slate-500">
                          Preview saved locally in your browser.
                        </p>
                        <div className="flex flex-wrap items-center justify-center sm:justify-start gap-2 pt-1">
                          <button
                            type="button"
                            onClick={() => fileInputRef.current?.click()}
                            className="inline-flex items-center gap-1 text-xs font-medium text-slate-700 hover:text-slate-900 bg-white border border-slate-200 px-3 py-1.5 rounded-xl hover:bg-slate-50 transition-colors focus:outline-none focus:ring-2 focus:ring-indigo-500"
                          >
                            <Upload className="w-3.5 h-3.5" />
                            <span>Change Image</span>
                          </button>
                          <button
                            type="button"
                            onClick={handleRemoveImage}
                            className="inline-flex items-center gap-1 text-xs font-medium text-rose-600 hover:text-rose-700 bg-rose-50 border border-rose-100 px-3 py-1.5 rounded-xl hover:bg-rose-100/70 transition-colors focus:outline-none focus:ring-2 focus:ring-rose-500"
                          >
                            <X className="w-3.5 h-3.5" />
                            <span>Remove</span>
                          </button>
                        </div>
                      </div>
                    </div>
                  ) : (
                    <label
                      htmlFor="mood-image-file"
                      className="cursor-pointer flex flex-col items-center justify-center border-2 border-dashed border-slate-200 hover:border-indigo-400 rounded-2xl p-5 bg-slate-50/50 hover:bg-indigo-50/20 transition-all text-center group"
                    >
                      <div className="w-10 h-10 rounded-xl bg-white border border-slate-200 flex items-center justify-center text-slate-500 group-hover:text-indigo-600 group-hover:border-indigo-200 mb-2 transition-colors">
                        <ImageIcon className="w-5 h-5" />
                      </div>
                      <span className="text-xs font-medium text-slate-700">
                        Click to select an image
                      </span>
                      <span className="text-[11px] text-slate-400 mt-0.5">
                        JPEG, PNG, or WebP up to 5 MB
                      </span>
                    </label>
                  )}

                  <input
                    ref={fileInputRef}
                    id="mood-image-file"
                    type="file"
                    accept="image/jpeg,image/png,image/webp"
                    onChange={handleImageChange}
                    className="sr-only"
                  />

                  {fileError && (
                    <p className="text-xs text-rose-600 font-medium" role="alert">
                      {fileError}
                    </p>
                  )}
                </div>

                {/* Feedback region */}
                <div aria-live="polite" className="min-h-[20px]">
                  {saveSuccessMessage && (
                    <div className="flex items-center gap-1.5 text-xs font-medium text-emerald-700 bg-emerald-50 border border-emerald-100 rounded-xl px-3 py-2">
                      <Check className="w-4 h-4 text-emerald-600" />
                      <span>{saveSuccessMessage}</span>
                    </div>
                  )}
                </div>

                {/* Save CTA */}
                <div className="flex items-center justify-end pt-2 border-t border-slate-100">
                  <button
                    type="submit"
                    disabled={!todayText.trim()}
                    className={`inline-flex items-center gap-2 px-5 py-2.5 rounded-2xl text-sm font-semibold transition-all shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 ${
                      !todayText.trim()
                        ? 'bg-slate-100 text-slate-400 cursor-not-allowed border border-slate-200'
                        : 'bg-indigo-600 hover:bg-indigo-700 text-white shadow-indigo-600/20 active:scale-[0.99]'
                    }`}
                  >
                    <Save className="w-4 h-4" />
                    <span>Save Today&apos;s Mood</span>
                  </button>
                </div>
              </form>
            </div>
          ) : selectedStatus === 'PAST' ? (
            /* ================= PAST DAY: READ ONLY CARD ================= */
            <div className="bg-white border border-slate-200 rounded-3xl p-5 sm:p-7 shadow-sm space-y-4">
              <div className="flex items-center justify-between border-b border-slate-100 pb-3">
                <div className="space-y-0.5">
                  <span className="text-xs font-medium text-slate-500 uppercase tracking-wide">
                    Past Entry
                  </span>
                  <h2 className="text-base sm:text-lg font-semibold text-slate-900">
                    {selectedDate.toLocaleDateString(undefined, {
                      weekday: 'long',
                      day: 'numeric',
                      month: 'long',
                      year: 'numeric',
                    })}
                  </h2>
                </div>
                <button
                  type="button"
                  onClick={handleGoToToday}
                  className="text-xs text-indigo-600 hover:text-indigo-700 font-medium px-2 py-1 rounded-lg hover:bg-indigo-50"
                >
                  Go to today
                </button>
              </div>

              {activeEntryForSelected?.mood ? (
                <div className="space-y-4 pt-1">
                  <blockquote className="text-slate-700 text-sm sm:text-base leading-relaxed bg-slate-50/70 border-l-2 border-indigo-400 p-4 rounded-r-2xl italic">
                    &ldquo;{activeEntryForSelected.mood}&rdquo;
                  </blockquote>

                  {activeEntryForSelected.imageUrl && (
                    <div className="max-w-xs rounded-2xl overflow-hidden border border-slate-200 bg-slate-50">
                      <img
                        src={activeEntryForSelected.imageUrl}
                        alt="Past mood reflection visual"
                        className="w-full h-44 object-cover"
                      />
                    </div>
                  )}
                </div>
              ) : (
                <div className="py-8 text-center space-y-1">
                  <p className="text-sm font-medium text-slate-600">No entry recorded</p>
                  <p className="text-xs text-slate-400">
                    No reflection was recorded for this day.
                  </p>
                </div>
              )}
            </div>
          ) : (
            /* ================= FUTURE DAY: PLACEHOLDER CARD ================= */
            <div className="bg-slate-50 border border-slate-200/80 rounded-3xl p-6 sm:p-8 text-center space-y-3">
              <div className="space-y-1">
                <span className="text-xs font-semibold text-slate-400 uppercase tracking-wider">
                  Upcoming
                </span>
                <h2 className="text-base sm:text-lg font-medium text-slate-700">
                  {selectedDate.toLocaleDateString(undefined, {
                    weekday: 'long',
                    day: 'numeric',
                    month: 'long',
                  })}
                </h2>
              </div>
              <p className="text-sm text-slate-500 max-w-xs mx-auto">
                Come back on this day to record how you feel.
              </p>
              <div className="pt-2">
                <button
                  type="button"
                  onClick={handleGoToToday}
                  className="inline-flex items-center gap-1.5 text-xs font-semibold text-indigo-600 bg-white border border-slate-200 px-3 py-1.5 rounded-xl hover:bg-slate-100 transition-colors"
                >
                  <span>Return to Today</span>
                </button>
              </div>
            </div>
          )}
        </section>
      </main>
    </div>
  );
}